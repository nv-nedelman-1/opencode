{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-nemo-relay",
  "version": "2.0.25",
  "description": "NVIDIA NeMo Relay integration for OpenCode",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/plugin-nemo-relay"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
